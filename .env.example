# =====================================================
# SAP environment template
# =====================================================
# Copy this file to .env and replace every placeholder value.
#
#   cp .env.example .env
#
# .env is ignored by Git and must never be committed.

# -------------------- Server --------------------

# Must be at least 64 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-random-string-of-at-least-64-characters-000000000000000000

PORT=5000
NODE_ENV=development

# Comma-separated browser origins allowed to call the API with credentials.
# Add the origin of any additional deployment or preview URL.
FRONTEND_URLS=http://localhost:5000,http://localhost:5500

# Optional host suffixes for generated URLs, such as hosted previews.
# ".e2b.app" allows https://5000-anything.e2b.app to call the API.
FRONTEND_ORIGIN_PATTERNS=

# -------------------- PostgreSQL --------------------
# Create the database first, for example:
#   createdb -U postgres sap

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sap
DB_USER=postgres
DB_PASSWORD=postgres

# Set DB_SSL=true for hosted databases that require TLS.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_SIZE=10

# -------------------- Demo seed accounts --------------------
# Required by npm run seed-users and npm run db:setup.
# Each password needs at least 12 characters, and they must all differ.
#
# One password covers the whole group:
#   SEED_STUDENT_PASSWORD  all 10 demo students (CU230101 - CU230110)
#   SEED_TEACHER_PASSWORD  all 4 demo teachers  (TCH2001 - TCH2004)

SEED_STUDENT_PASSWORD=student-password-12
SEED_TEACHER_PASSWORD=teacher-password-12

# Required by npm run seed-admin and npm run db:setup.
SEED_ADMIN_PASSWORD=administrator-password-12
SEED_ADMIN_LOGIN_ID=ADM1001
SEED_ADMIN_NAME=SAP Administrator
# SEED_ADMIN_EMAIL=admin@sap.edu

# -------------------- WebAuthn passkeys --------------------
# The RP ID is the bare domain (no scheme or port) that serves the portal.
# Passkeys only work on HTTPS or on http://localhost.

WEBAUTHN_RP_NAME=Smart Attendance Portal
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:5000,http://localhost:5500

# -------------------- Location checks --------------------
# How old a browser location reading may be before it is rejected (ms).

LOCATION_MAX_AGE_MS=120000
